POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
# 数据库只读账号（供管理台使用，只能查看/查询/导出，不能修改）
POSTGRES_READONLY_USER=readonly_user
POSTGRES_READONLY_PASSWORD=change-me
JWT_SECRET=change-me
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
STATS_SERVICE_PORT=3002
# ===== 运维管理台（Node 自研，中文界面）=====
# 管理台 Web 端口（宿主机）
DASHBOARD_PORT=3100
# 管理台登录账号密码，生产环境必须修改
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# 会话加密密钥，生产环境请改为随机长字符串
DASHBOARD_SESSION_SECRET=change-me
# 对外可访问的网关地址，接口中心会写入 OpenAPI servers 与 AI 说明书
# 未设置时默认 http://localhost:3005，上公网后建议改为真实域名
PUBLIC_BASE_URL=http://localhost:3005
