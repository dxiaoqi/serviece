# 对外映射端口（宿主机）
HOST_PORT=3000

# ===== 对象存储驱动 =====
# local：本地/占位模式，不依赖外部存储，适合开发起步
# oss  ：阿里云 OSS（需把下面 OSS_* 填全，否则自动回退 local）
STORAGE_DRIVER=local

# local 模式下对外拼接地址的基址（可选，留空则返回相对路径 /<key>）
STORAGE_PUBLIC_BASE_URL=

# ===== 阿里云 OSS（STORAGE_DRIVER=oss 时生效）=====
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# CDN 加速域名（可选）。配置后播放/读取签名基于该域名生成
OSS_CDN_DOMAIN=

# 管理端直传使用的 RAM 角色 ARN（STS 直传时必填）
OSS_STS_ROLE_ARN=

# 读取/播放签名有效期（秒），建议 300~900
OSS_SIGN_EXPIRES_SEC=600

# 上传凭证/STS 有效期（秒），最小 900
OSS_UPLOAD_EXPIRES_SEC=900
