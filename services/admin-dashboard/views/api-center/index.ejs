<%- include('../partials/header') %>

<div class="panel">
  <div class="panel-header">接入概览</div>
  <div class="panel-body">
    <div class="kv">
      <div class="k">网关基址</div><div class="path-text"><%= baseUrl %></div>
      <div class="k">统一响应</div><div class="path-text">{ code, message, data }，code = 0 表示成功</div>
      <div class="k">鉴权方式</div><div>公开接口直接调用；需登录接口在请求头携带 <span class="path-text">Authorization: Bearer &lt;token&gt;</span></div>
      <div class="k">跨域</div><div>已开启 CORS，浏览器可直接跨域调用</div>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    接口契约导出
    <span class="copy-row">
      <a class="btn small" href="/api-center/openapi.json">下载 OpenAPI JSON</a>
      <a class="btn small" href="/api-center/openapi.yaml">下载 OpenAPI YAML</a>
      <a class="btn small" href="/api-center/ai-brief.md">下载 Markdown</a>
    </span>
  </div>
  <div class="panel-body">
    <div class="alert info" style="margin-bottom:0;">
      复制下方「AI 接入说明书」连同 OpenAPI 文件一起发给其他 AI，它在写前端时即可直接按契约接入；OpenAPI 文件也可导入接口调试工具生成客户端代码。
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">接口列表（共 <%= endpoints.length %> 个）</div>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>分组</th>
          <th>方法</th>
          <th>路径</th>
          <th>说明</th>
          <th>鉴权</th>
        </tr>
      </thead>
      <tbody>
        <% endpoints.forEach(function(ep) { %>
          <tr>
            <td><%= ep.group %></td>
            <td><span class="method <%= ep.method.toLowerCase() %>"><%= ep.method %></span></td>
            <td class="path-text"><%= ep.path %></td>
            <td><%= ep.summary %></td>
            <td>
              <% if (ep.auth === 'bearer') { %>
                <span class="badge other">需登录</span>
              <% } else { %>
                <span class="badge ok">公开</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    AI 接入说明书
    <span class="copy-row">
      <span id="copyTip" class="copied" style="visibility:hidden;">已复制</span>
      <button class="btn small primary" type="button" id="copyBriefBtn">一键复制</button>
    </span>
  </div>
  <div class="panel-body">
    <textarea id="aiBrief" class="brief-box" readonly><%= aiBrief %></textarea>
  </div>
</div>

<script>
(function () {
  var btn = document.getElementById('copyBriefBtn');
  var box = document.getElementById('aiBrief');
  var tip = document.getElementById('copyTip');
  btn.addEventListener('click', function () {
    var text = box.value;
    var done = function () {
      tip.style.visibility = 'visible';
      setTimeout(function () { tip.style.visibility = 'hidden'; }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done).catch(function () { fallback(); });
    } else {
      fallback();
    }
    function fallback() {
      box.removeAttribute('readonly');
      box.select();
      try { document.execCommand('copy'); done(); } catch (e) {}
      box.setAttribute('readonly', true);
    }
  });
})();
</script>

<%- include('../partials/footer') %>
