<%- include('../partials/header') %>

<div class="panel">
  <div class="panel-header">数据库列表</div>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th>数据库名称</th>
          <th>所有者</th>
          <th>大小</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% databases.forEach(function(db) { %>
          <tr>
            <td style="font-weight:600;"><%= db.name %></td>
            <td><%= db.owner %></td>
            <td><%= bytes(db.size) %></td>
            <td style="white-space:nowrap;">
              <a class="btn small" href="/databases/<%= db.name %>/tables">数据表</a>
              <a class="btn small" href="/databases/<%= db.name %>/sql">SQL 查询</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="alert info">当前使用只读账号连接，仅支持查看、查询与导出；任何写入操作都会被数据库拒绝。</div>

<%- include('../partials/footer') %>
